# Copy this file to .env.local and fill in ONE of the two providers below.
# The app uses OpenAI if OPENAI_API_KEY is set, otherwise falls back to Gemini.

# Option A: OpenAI (uses gpt-4o vision by default)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o

# Option B: Google Gemini (recommended default — newest Flash model)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
